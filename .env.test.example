# Plantilla para .env.test (que SÍ tiene credenciales reales y NO se commitea).
#
# Crear .env.test (gitignored) con las URLs del branch de Neon dedicado a
# tests. NUNCA usar las URLs de prod — los tests truncan tablas. El guard
# en tests/setup/env.ts aborta si las URLs apuntan al endpoint de prod.

# Pooler endpoint del branch de test. La usa el runtime de Prisma.
DATABASE_URL_TEST="postgresql://<usuario>:<password>@<endpoint-test>-pooler.<region>.aws.neon.tech/<db>?sslmode=require&channel_binding=require"

# Direct endpoint del branch de test. La usa `prisma migrate deploy` (no
# soporta pooler para DDL).
DIRECT_URL_TEST="postgresql://<usuario>:<password>@<endpoint-test>.<region>.aws.neon.tech/<db>?sslmode=require&channel_binding=require"

# Confirmación humana de que las URLs apuntan al branch de test, no a prod.
# Setearlo es una firma "ya verifiqué que esto NO es prod". El guard exige
# que sea exactamente "true". Si dudás, comentá esta línea: el guard aborta
# y los tests no corren hasta que vuelvas a confirmarlo.
TEST_DB_CONFIRMED=true
