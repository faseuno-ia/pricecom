# Base de datos
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/precio_mayorista"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="genera-con: openssl rand -base64 32"

# Cifrado AES-256 para contraseñas de proveedores
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="cambia-esto-por-64-caracteres-hex-aleatorios"

# Worker: intervalo de polling en milisegundos
WORKER_POLL_INTERVAL=5000

# Worker: tiempo máximo que un job puede estar en RUNNING antes de liberarse (ms)
# Default: 10 minutos. Si el worker muere, el job vuelve a PENDING automáticamente.
WORKER_STALE_TIMEOUT_MS=600000

# URL pública de la app (para links en emails futuros, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Futura migración a Redis/BullMQ (no requerido ahora)
# REDIS_URL="redis://localhost:6379"
