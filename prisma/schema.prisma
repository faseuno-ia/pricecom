generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String // hash bcrypt
  name      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  providers       Provider[]
  extractionJobs  ExtractionJob[]
  catalogProducts CatalogProduct[]
}

model Provider {
  id                String                 @id @default(cuid())
  name              String
  baseUrl           String
  requiresLogin     Boolean                @default(false)
  username          String?
  encryptedPassword String?
  isActive          Boolean                @default(true)
  notes             String?
  lastExtractionAt  DateTime?
  userId            String?
  user              User?                  @relation(fields: [userId], references: [id])
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  scraperConfig     ProviderScraperConfig?
  extractionJobs    ExtractionJob[]
  catalogProducts   CatalogProduct[]

  @@index([userId])
}

model ProviderScraperConfig {
  id                    String   @id @default(cuid())
  providerId            String   @unique
  provider              Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  productCardSelector   String?
  skuSelector           String?
  nameSelector          String?
  descriptionSelector   String?
  priceSelector         String?
  oldPriceSelector      String?
  stockSelector         String?
  categorySelector      String?
  imageSelector         String?
  productUrlSelector    String?
  nextPageSelector      String?
  maxPages              Int      @default(10)
  waitForSelector       String?
  loginUsernameSelector String?
  loginPasswordSelector String?
  loginSubmitSelector   String?
  /// Prefijo opcional para nombres de archivo en descarga masiva de imágenes (ej: "ART_" → ART_12345.jpg)
  imageFilenamePrefix   String?
  /// Para sitios sin paginación clásica que dividen el catálogo en categorías URL
  /// (ej: Impotekno). Si está configurado, el scraper lee este <select> y itera
  /// por cada option.value usando categoryParamName como query string.
  categoryParamSelector String?
  /// Nombre del parámetro URL para iterar categorías (ej: "rub" → ?rub=N)
  categoryParamName     String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model ExtractionJob {
  id                   String                 @id @default(cuid())
  providerId           String
  provider             Provider               @relation(fields: [providerId], references: [id])
  userId               String?
  user                 User?                  @relation(fields: [userId], references: [id])
  status               JobStatus              @default(PENDING)
  startUrl             String?
  startedAt            DateTime?
  finishedAt           DateTime?
  /// Porcentaje de progreso 0-100 (actualizado por el worker página a página)
  progress             Int                    @default(0)
  totalProducts        Int                    @default(0)
  productsWithPrice    Int                    @default(0)
  productsWithoutPrice Int                    @default(0)
  productsWithoutSku   Int                    @default(0)
  /// Ruta local del archivo Excel generado (relativa a /public)
  excelFilePath        String?
  /// URL pública para descarga desde el navegador
  excelFileUrl         String?
  errorMessage         String?
  /// Timestamp del momento en que un worker tomó el job (para detección de locks muertos)
  workerLockedAt       DateTime?
  /// ID del proceso worker que bloqueó el job (útil para debug multi-instancia)
  workerPid            Int?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  products             ExtractedProduct[]
  logs                 ExtractionLog[]
  comparison           ExtractionComparison?
  previousJobFor       ExtractionComparison[] @relation("PreviousJob")

  @@index([status, createdAt])
  @@index([userId])
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum ProductChangeType {
  NEW
  REMOVED
  PRICE_UP
  PRICE_DOWN
  STOCK_CHANGED
}

model ExtractionComparison {
  id              String         @id @default(cuid())
  jobId           String         @unique
  job             ExtractionJob  @relation(fields: [jobId], references: [id])
  previousJobId   String?
  previousJob     ExtractionJob? @relation("PreviousJob", fields: [previousJobId], references: [id])
  newProducts     Int            @default(0)
  removedProducts Int            @default(0)
  priceUp         Int            @default(0)
  priceDown       Int            @default(0)
  stockChanged    Int            @default(0)
  unchanged       Int            @default(0)
  createdAt       DateTime       @default(now())

  changes ProductChange[]
}

model ProductChange {
  id                 String               @id @default(cuid())
  comparisonId       String
  comparison         ExtractionComparison @relation(fields: [comparisonId], references: [id])
  sku                String?
  productUrl         String?
  /// hash(name + brand) como fallback de identidad cuando no hay sku ni productUrl
  nameHash           String?
  name               String
  changeType         ProductChangeType
  previousPrice      Float?
  currentPrice       Float?
  priceChangePercent Float?
  previousStock      String?
  currentStock       String?
  createdAt          DateTime             @default(now())

  @@index([comparisonId])
  @@index([comparisonId, changeType])
  @@index([sku])
  @@index([changeType])
  @@index([createdAt])
}

model ExtractedProduct {
  id                     String           @id @default(cuid())
  jobId                  String
  job                    ExtractionJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  providerId             String
  sku                    String?
  name                   String
  description            String?
  wholesalePrice         Decimal?         @db.Decimal(10, 2)
  oldPrice               Decimal?         @db.Decimal(10, 2)
  stock                  String?
  category               String?
  brand                  String?
  productUrl             String?
  imageUrl               String?
  /// Nombre de archivo de la imagen descargada (sin path, ej: "ART_12345.jpg")
  imageFileName          String?
  /// Ruta local en disco si la imagen fue descargada
  imageFilePath          String?
  /// Cuándo se descargó la imagen
  imageDownloadedAt      DateTime?
  status                 String?
  observations           String?
  rawData                Json?
  extractedAt            DateTime         @default(now())
  /// null | "selected" | "prepared" | "published" — flag legacy del flow de publicación
  /// a nivel snapshot. Para el estado canónico ver CatalogProduct.publications.
  publicationStatus      String?
  catalogProductSnapshot CatalogProduct[] @relation("LatestSnapshot")

  @@index([jobId])
  @@index([providerId])
  @@index([sku])
}

model ExtractionLog {
  id        String        @id @default(cuid())
  jobId     String
  job       ExtractionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  level     LogLevel      @default(INFO)
  message   String
  metadata  Json?
  createdAt DateTime      @default(now())

  @@index([jobId])
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

// ─── Ecommerce Integration (futuro) ───────────────────────────────────────────

model Store {
  id          String   @id @default(cuid())
  name        String
  platform    String // "tiendanube" | "shopify" | "woocommerce"
  url         String
  isActive    Boolean  @default(true)
  credentials String? // cifrado AES-256 igual que Provider
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  integrations StoreIntegration[]
  publications ProductPublication[]
}

model StoreIntegration {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  config    String? // JSON con config específica de la plataforma
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Catálogo persistente + publicaciones ────────────────────────────────────

enum CatalogProductStatus {
  ACTIVE
  SUPPLIER_REMOVED
  IGNORED
  ARCHIVED
}

enum PublicationStatus {
  DRAFT
  ACTIVE
  PAUSED
  REMOVED
  ERROR
}

/// Catálogo persistente por usuario × proveedor. Es la fuente de verdad comercial:
/// el worker solo actualiza los campos "supplier*" en cada extracción, los campos
/// comerciales (commercialName, assignedCategory, manualPrice, pricingRule, notes)
/// son editados exclusivamente por el usuario y nunca pisados por el scraper.
model CatalogProduct {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id])

  // Identidad del producto (clave de upsert)
  sku          String?
  productUrl   String?
  identityHash String? // hash(name + providerId) como fallback

  // Datos del proveedor (sync automático)
  supplierName        String
  supplierDescription String?
  wholesalePrice      Float?
  stock               String?
  supplierCategory    String?
  imageUrl            String?
  lastSeenAt          DateTime
  supplierStatus      CatalogProductStatus @default(ACTIVE)

  // Referencia al último snapshot extraído (linea de tiempo)
  latestExtractedProductId String?
  latestExtractedProduct   ExtractedProduct? @relation("LatestSnapshot", fields: [latestExtractedProductId], references: [id])

  // Datos comerciales editados por el usuario (worker NUNCA toca)
  commercialName        String?
  commercialDescription String?
  assignedCategoryId    String?
  assignedCategory      Category?    @relation(fields: [assignedCategoryId], references: [id])
  manualPrice           Float?
  pricingRuleId         String?
  pricingRule           PricingRule? @relation(fields: [pricingRuleId], references: [id])
  notes                 String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  publications ProductPublication[]

  @@unique([userId, providerId, sku])
  @@index([userId])
  @@index([providerId])
  @@index([supplierStatus])
  @@index([userId, providerId])
}

model ProductPublication {
  id                String            @id @default(cuid())
  catalogProductId  String
  catalogProduct    CatalogProduct    @relation(fields: [catalogProductId], references: [id])
  storeId           String
  store             Store             @relation(fields: [storeId], references: [id])
  status            PublicationStatus @default(DRAFT)
  externalProductId String?
  externalUrl       String?
  publishedAt       DateTime?
  pausedAt          DateTime?
  lastSyncAt        DateTime?
  errorMessage      String?
  finalPrice        Float?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([catalogProductId, storeId])
  @@index([catalogProductId])
  @@index([storeId])
  @@index([status])
}

model PricingRule {
  id        String   @id @default(cuid())
  scope     String // "global" | "provider" | "category" | "product"
  scopeId   String? // providerId, categoryId o productId según scope
  method    String // "markup" | "margin"
  value     Float // porcentaje
  rounding  Int? // redondear al múltiplo más cercano (ej: 100)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  catalogProducts CatalogProduct[]
}

model Category {
  id        String                   @id @default(cuid())
  name      String
  slug      String?
  parentId  String?
  parent    Category?                @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[]               @relation("CategoryTree")
  mappings  ProductCategoryMapping[]
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  catalogProducts CatalogProduct[]
}

model ProductCategoryMapping {
  id               String   @id @default(cuid())
  providerCategory String // categoría tal como viene del proveedor
  categoryId       String
  category         Category @relation(fields: [categoryId], references: [id])
  createdAt        DateTime @default(now())
}
