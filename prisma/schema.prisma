generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String // hash bcrypt
  name      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  providers       Provider[]
  extractionJobs  ExtractionJob[]
  catalogProducts CatalogProduct[]
  pricingRules    PricingRule[]
  stores          Store[]
  eventLogs       EventLog[]
}

enum ProviderType {
  /// Catálogo obtenido vía web scraping automatizado.
  SCRAPER
  /// Catálogo obtenido vía WooCommerce Store API (JSON), sin scraping de HTML.
  WOO_STORE_API
  /// Carga manual producto por producto (sin scraping).
  MANUAL
  /// Carga masiva por archivo Excel/CSV.
  IMPORTED
  /// Stock propio del cliente — productos sin proveedor externo.
  OWN_STOCK
}

model Provider {
  id                String                 @id @default(cuid())
  name              String
  /// Cómo se mantiene el catálogo de este proveedor.
  providerType      ProviderType           @default(SCRAPER)
  baseUrl           String
  requiresLogin     Boolean                @default(false)
  username          String?
  encryptedPassword String?
  isActive          Boolean                @default(true)
  notes             String?
  /// Descuento comercial que el proveedor aplica sobre su lista de precios.
  /// Se descuenta del wholesalePrice antes de calcular el precio de venta.
  /// 0 = sin descuento. Ejemplo: 12 = 12% off list.
  listDiscountPercent Decimal              @default(0) @db.Decimal(5, 2)
  /// Prefijo del SKU comercial para productos de este proveedor (ej: "TEK-").
  /// Se concatena al supplierSku cuando se asigna SKU comercial a una
  /// publication (feature lazy SKU — paso siguiente). Validado en API:
  /// /^[A-Z0-9-]{0,10}$/.
  skuPrefix         String                 @default("")
  lastExtractionAt  DateTime?
  userId            String?
  user              User?                  @relation(fields: [userId], references: [id])
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  scraperConfig     ProviderScraperConfig?
  extractionJobs    ExtractionJob[]
  catalogProducts   CatalogProduct[]
  eventLogs         EventLog[]

  @@index([userId])
}

model ProviderScraperConfig {
  id                    String   @id @default(cuid())
  providerId            String   @unique
  provider              Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  productCardSelector   String?
  skuSelector           String?
  nameSelector          String?
  descriptionSelector   String?
  priceSelector         String?
  oldPriceSelector      String?
  stockSelector         String?
  categorySelector      String?
  imageSelector         String?
  productUrlSelector    String?
  nextPageSelector      String?
  maxPages              Int      @default(10)
  waitForSelector       String?
  loginUsernameSelector String?
  loginPasswordSelector String?
  loginSubmitSelector   String?
  /// Prefijo opcional para nombres de archivo en descarga masiva de imágenes (ej: "ART_" → ART_12345.jpg)
  imageFilenamePrefix   String?
  /// Para sitios sin paginación clásica que dividen el catálogo en categorías URL
  /// (ej: Impotekno). Si está configurado, el scraper lee este <select> y itera
  /// por cada option.value usando categoryParamName como query string.
  categoryParamSelector String?
  /// Nombre del parámetro URL para iterar categorías (ej: "rub" → ?rub=N)
  categoryParamName     String?
  /// URL del catálogo post-login. Algunos sitios (ej: Impotekno) tienen el
  /// login en `/` pero el listado de productos en otra ruta (`/catalogo_imptk.php`)
  /// y el redirect del form no siempre es confiable. Si está seteado, el
  /// scraper navega explícitamente acá después del login y antes de buscar
  /// el `categoryParamSelector`.
  catalogUrl            String?
  extractionMode    String?
  loginUrl          String?
  loginFlowStrategy String?
  /// 2G-R7.2 · Autoridad de escritura del catálogo (config-driven, genérico). null → FULL
  /// (histórico). "PRICE_ONLY" → sólo wholesalePrice + lastSeenAt + latestExtractedProductId;
  /// preserva metadata/lifecycle/publications/Woo. Resolver fail-loud ante valores inválidos.
  catalogWriteMode  String?
  /// 2G-R10-PR19 · Autoridad de ORQUESTADOR por proveedor (config-driven, explícita). null/""/"LEGACY"
  /// → LEGACY (orquestador histórico; default seguro, sin cambio de conducta al desplegar). "GUARDED_
  /// PRICE_ONLY" → orquestador con reconciliación + health gate + price preflight + lifecycle shadow +
  /// commit fenced PRICE_ONLY (opt-in EXPLÍCITO por proveedor). Resolver fail-loud ante valores inválidos.
  writeOrchestrationMode String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model ExtractionJob {
  id                   String                 @id @default(cuid())
  providerId           String
  provider             Provider               @relation(fields: [providerId], references: [id])
  userId               String?
  user                 User?                  @relation(fields: [userId], references: [id])
  status               JobStatus              @default(PENDING)
  startUrl             String?
  startedAt            DateTime?
  finishedAt           DateTime?
  /// Porcentaje de progreso 0-100 (actualizado por el worker página a página)
  progress             Int                    @default(0)
  totalProducts        Int                    @default(0)
  productsWithPrice    Int                    @default(0)
  productsWithoutPrice Int                    @default(0)
  productsWithoutSku   Int                    @default(0)
  /// Ruta local del archivo Excel — legacy. Se mantiene por compatibilidad con
  /// jobs históricos; los nuevos jobs persisten el binario en excelData.
  excelFilePath        String?
  /// URL pública para descarga desde el navegador. Se sigue seteando para que
  /// la UI use el mismo link tanto para jobs legacy como para los nuevos.
  excelFileUrl         String?
  /// Binario del Excel generado al finalizar la extracción. Reemplaza el
  /// almacenamiento en filesystem (el contenedor de Railway es efímero y los
  /// archivos se perdían en cada redeploy).
  excelData            Bytes?
  /// Nombre del archivo (ej: "extraccion_toys_palace_<jobId>_<ts>.xlsx").
  /// Es la clave por la que el endpoint de descarga busca el binario.
  excelName            String?
  errorMessage         String?
  /// Timestamp del momento en que un worker tomó el job (para detección de locks muertos)
  workerLockedAt       DateTime?
  /// ID del proceso worker que bloqueó el job (útil para debug multi-instancia)
  workerPid            Int?
  /// Origen del job. null = scraper automático (default histórico, lo procesa
  /// el worker). "IMPORT" = job sintético creado por POST /api/catalog/import
  /// para emitir cambios comerciales contra un Excel del usuario; el worker
  /// los ignora.
  source               String?
  /// Cuando source = "IMPORT", apunta al batchId del lote de importación.
  importBatchId        String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  products             ExtractedProduct[]
  logs                 ExtractionLog[]
  comparison           ExtractionComparison?
  previousJobFor       ExtractionComparison[] @relation("PreviousJob")
  eventLogs            EventLog[]

  @@index([status, createdAt])
  @@index([userId])
  @@index([source])
  @@index([importBatchId])
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum ProductChangeType {
  NEW
  REMOVED
  PRICE_UP
  PRICE_DOWN
  STOCK_CHANGED
}

model ExtractionComparison {
  id              String         @id @default(cuid())
  jobId           String         @unique
  job             ExtractionJob  @relation(fields: [jobId], references: [id])
  previousJobId   String?
  previousJob     ExtractionJob? @relation("PreviousJob", fields: [previousJobId], references: [id])
  newProducts     Int            @default(0)
  removedProducts Int            @default(0)
  priceUp         Int            @default(0)
  priceDown       Int            @default(0)
  stockChanged    Int            @default(0)
  unchanged       Int            @default(0)
  createdAt       DateTime       @default(now())

  changes ProductChange[]
}

enum ChangeReviewStatus {
  PENDING
  REVIEWED
  IGNORED
}

model ProductChange {
  id                 String               @id @default(cuid())
  comparisonId       String
  comparison         ExtractionComparison @relation(fields: [comparisonId], references: [id])
  sku                String?
  productUrl         String?
  /// hash(name + brand) como fallback de identidad cuando no hay sku ni productUrl
  nameHash           String?
  name               String
  changeType         ProductChangeType
  previousPrice      Float?
  currentPrice       Float?
  priceChangePercent Float?
  previousStock      String?
  currentStock       String?
  /// Estado de revisión comercial — el usuario marca PENDING/REVIEWED/IGNORED
  /// para llevar el radar al día sin perder histórico.
  reviewStatus       ChangeReviewStatus   @default(PENDING)
  reviewedAt         DateTime?
  /// Cuando el change proviene de un import Excel (no de una extracción
  /// automática), guardamos el batchId del lote para poder filtrar/agrupar
  /// sin tener que joinearse a ExtractionJob.
  importBatchId      String?
  createdAt          DateTime             @default(now())

  @@index([comparisonId])
  @@index([comparisonId, changeType])
  @@index([sku])
  @@index([changeType])
  @@index([createdAt])
  @@index([reviewStatus])
  @@index([changeType, reviewStatus])
  @@index([importBatchId])
}

model ExtractedProduct {
  id                     String           @id @default(cuid())
  jobId                  String
  job                    ExtractionJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  providerId             String
  sku                    String?
  name                   String
  description            String?
  wholesalePrice         Decimal?         @db.Decimal(10, 2)
  oldPrice               Decimal?         @db.Decimal(10, 2)
  stock                  String?
  category               String?
  brand                  String?
  productUrl             String?
  imageUrl               String?
  /// Nombre de archivo de la imagen descargada (sin path, ej: "ART_12345.jpg")
  imageFileName          String?
  /// Ruta local en disco si la imagen fue descargada
  imageFilePath          String?
  /// Cuándo se descargó la imagen
  imageDownloadedAt      DateTime?
  status                 String?
  observations           String?
  rawData                Json?
  extractedAt            DateTime         @default(now())
  /// null | "selected" | "prepared" | "published" — flag legacy del flow de publicación
  /// a nivel snapshot. Para el estado canónico ver CatalogProduct.publications.
  publicationStatus      String?
  catalogProductSnapshot CatalogProduct[] @relation("LatestSnapshot")

  @@index([jobId])
  @@index([providerId])
  @@index([sku])
}

model ExtractionLog {
  id        String        @id @default(cuid())
  jobId     String
  job       ExtractionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  level     LogLevel      @default(INFO)
  message   String
  metadata  Json?
  createdAt DateTime      @default(now())

  @@index([jobId])
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

// ─── Ecommerce Integration ────────────────────────────────────────────────────

enum StorePlatform {
  WOOCOMMERCE
  SHOPIFY
  TIENDANUBE
}

/// Estado del ciclo de sincronización de una publicación contra la tienda
/// externa. Lo manipulan el sync engine, el drift detector y las acciones
/// manuales del usuario.
enum PublicationSyncStatus {
  READY
  PENDING_SYNC
  SYNCED
  OUTDATED
  ERROR
  PAUSED
  /// El SKU canónico (pp.sku) colisiona con otro producto YA EXISTENTE en
  /// la tienda externa. NO es transitorio — reintentar no resuelve nada.
  /// El usuario tiene que renombrar el SKU desde el drawer o limpiar el
  /// duplicado en la tienda. Cuando esta publication tiene este status,
  /// se la saca de la cola de reintento (pendingSync=false).
  ERROR_SKU_CONFLICT
  /// Error TERMINAL genérico de push/pause (validación/datos/4xx, o transporte
  /// no mapeado): reintentar no ayuda. Sale de la cola del drainer POR VALOR
  /// (no está en su OR), igual que ERROR_SKU_CONFLICT. pendingSync=false.
  /// Requiere intervención manual.
  ERROR_TERMINAL
}

model Store {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  name        String
  platform    StorePlatform
  url         String
  isActive    Boolean       @default(true)
  /// Cifrado AES-256 — legacy bag para credenciales no estructuradas.
  credentials String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  integrations       StoreIntegration[]
  publications       ProductPublication[]
  categories         StoreCategory[]
  unmatchedProducts  UnmatchedStoreProduct[]
  eventLogs          EventLog[]

  @@index([userId])
  @@index([userId, platform])
}

model StoreIntegration {
  id                      String    @id @default(cuid())
  storeId                 String
  store                   Store     @relation(fields: [storeId], references: [id])
  /// JSON con config específica de la plataforma (rate limits, prefijos, etc).
  config                  String?
  /// Credenciales WooCommerce REST API v3 — cifradas AES-256.
  consumerKeyEncrypted    String?
  consumerSecretEncrypted String?
  /// "CONNECTED" | "ERROR" | "DISCONNECTED" | null (sin probar todavía).
  status                  String?
  lastConnectionCheck     DateTime?
  lastError               String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([storeId])
}

/// Árbol de categorías sincronizado desde la tienda externa. La jerarquía se
/// guarda dos veces: parentExternalId (id de WooCommerce/etc) y parentId (FK
/// interna) — el sync hace dos pasadas: primero crea/actualiza, después
/// resuelve los parentId con los externalCategoryId ya guardados.
model StoreCategory {
  id                 String          @id @default(cuid())
  storeId            String
  store              Store           @relation(fields: [storeId], references: [id])
  externalCategoryId String
  name               String
  slug               String?
  parentExternalId   String?
  parentId           String?
  parent             StoreCategory?  @relation("StoreCategoryTree", fields: [parentId], references: [id])
  children           StoreCategory[] @relation("StoreCategoryTree")
  /// Mapeo a la Category interna. null = sin vincular.
  categoryId         String?
  category           Category?       @relation(fields: [categoryId], references: [id])
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([storeId, externalCategoryId])
  @@index([storeId])
  @@index([parentId])
  @@index([parentExternalId])
  @@index([categoryId])
}

/// Productos detectados en la tienda externa que no matchean con ningún
/// CatalogProduct del usuario. Los persistimos para que el cliente pueda
/// vincularlos a mano, crearles un CatalogProduct nuevo, o ignorarlos.
model UnmatchedStoreProduct {
  id                String   @id @default(cuid())
  storeId           String
  store             Store    @relation(fields: [storeId], references: [id])
  externalProductId String
  externalSku       String?
  name              String
  price             Float?
  stockQuantity     Int?
  imageUrl          String?
  /// JSON array de nombres de categoría que viene de la tienda.
  categories        String?
  permalink         String?
  /// Estado del producto en la tienda externa al momento del último sync
  /// ("publish" | "draft" | "private" | "pending" | "trash" en WooCommerce).
  /// Lo usa el endpoint de link para crear la ProductPublication con el
  /// status correcto (ACTIVE si era "publish", DRAFT si no).
  externalStatus    String?
  /// El producto ya fue procesado por el usuario o por el sistema: se
  /// vinculó (link), se creó en Mi stock (create-catalog), o se descartó
  /// manualmente (resolve). Cubre todos los caminos por los que un
  /// unmatched sale de la pestaña por defecto. La distinción
  /// "vinculado vs descartado manual" se hace mirando si existe una
  /// ProductPublication con el mismo externalProductId.
  resolved          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([storeId, externalProductId])
  @@index([storeId])
  @@index([storeId, resolved])
}

// ─── Catálogo persistente + publicaciones ────────────────────────────────────

enum CatalogProductStatus {
  ACTIVE
  SUPPLIER_REMOVED
}

enum PublicationStatus {
  DRAFT
  ACTIVE
  PAUSED
  REMOVED
  ERROR
}

/// Origen de una CatalogProductImage. Contrato:
///   STORE     → relación verificada con la tienda externa vía sync directo.
///   USER      → la subió el usuario, o el origen no es demostrable a nivel de fila.
///   SUPPLIER  → (futuro) imagen importada del catálogo del proveedor.
///   GENERATED → (futuro) generada / placeholder / IA.
/// Ver docs/sprint-1a-image-source-model.md. STORE se introdujo en 1A vacío;
/// las filas existentes no se reclasifican (Estrategia B, fila por fila desde
/// Sprint 4). El orden de los valores en este enum es cosmético — Postgres
/// preserva el orden físico de creación independientemente del schema.
enum ImageSource {
  SUPPLIER
  USER
  STORE
  GENERATED
}

/// De dónde provino la fila del CatalogProduct. SCRAPED es el default histórico
/// (alimentado por el worker); MANUAL es alta one-off por UI; IMPORTED viene de
/// un upload Excel/CSV. Distinto de supplierStatus (que indica si el proveedor
/// sigue mostrándolo).
enum CatalogSourceType {
  SCRAPED
  MANUAL
  IMPORTED
}

/// Origen del stock que se vende.
///   SUPPLIER → dependemos del proveedor; si lo remueven, deberíamos pausar.
///   OWN      → el cliente lo tiene físicamente; sobrevive a SUPPLIER_REMOVED.
///   HYBRID   → mixto (no se auto-pausa).
enum StockSource {
  SUPPLIER
  OWN
  HYBRID
}

/// Estado interno del workflow comercial del producto. Independiente de
/// supplierStatus (que refleja si el scraper lo sigue viendo en el proveedor).
enum InternalPublicationStatus {
  NOT_PUBLISHED
  PREPARED
  /// Publicado en la tienda (sincronizado vía /api/my-store/sync/products).
  /// El sync respeta IGNORED y PAUSED — no los pisa con PUBLISHED.
  PUBLISHED
  PAUSED
  IGNORED
}

/// Catálogo persistente por usuario × proveedor. Es la fuente de verdad comercial:
/// el worker solo actualiza los campos "supplier*" en cada extracción, los campos
/// comerciales (commercialName, assignedCategory, manualPrice, pricingRule, notes)
/// son editados exclusivamente por el usuario y nunca pisados por el scraper.
model CatalogProduct {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id])

  // Identidad del producto (clave de upsert)
  sku             String?
  /// SKU comercial para tienda: prefijo del proveedor + supplierSku (ej: B380-94028).
  /// Se setea al importar la tienda existente; no lo toca el worker.
  publicationSku  String?
  productUrl      String?
  identityHash    String? // hash(name + providerId) como fallback

  /// Identidad técnica canónica (Gate 2). Se completa en 3B+; hoy inerte.
  sourceIdentityKey String?
  /// ID externo del producto padre en la fuente (ej. TiendaNube product_id). Inerte hoy.
  externalProductId String?
  /// ID externo de la variante en la fuente (ej. TiendaNube variant id). Inerte hoy.
  externalVariantId String?

  /// De dónde provino esta fila: scrape automático, alta manual o import por archivo.
  sourceType       CatalogSourceType @default(SCRAPED)
  /// Nota libre para productos cargados manualmente (referencia, contacto, etc.).
  manualSourceNote String?
  /// Identificador del lote de importación (cuando sourceType=IMPORTED). Útil
  /// para revertir o agrupar lo importado en una sesión.
  importBatchId    String?

  /// Origen del stock. SUPPLIER es lo histórico (default). OWN para productos
  /// que el cliente tiene físicamente y vende aunque el proveedor desaparezca.
  /// HYBRID para casos mixtos. Determina si SUPPLIER_REMOVED debe auto-pausar
  /// la publicación.
  stockSource            StockSource     @default(SUPPLIER)
  /// Si este producto fue copiado desde otro CatalogProduct (típicamente para
  /// migrarlo a stock propio antes de que el proveedor lo dé de baja), apunta
  /// al original. Self-relation.
  sourceCatalogProductId String?
  sourceCatalogProduct   CatalogProduct? @relation("CatalogProductSource", fields: [sourceCatalogProductId], references: [id])
  derivedProducts        CatalogProduct[] @relation("CatalogProductSource")

  // Datos del proveedor (sync automático)
  supplierName        String
  supplierDescription String?
  wholesalePrice      Float?
  stock               String?
  supplierCategory    String?
  imageUrl            String?
  lastSeenAt          DateTime
  supplierStatus      CatalogProductStatus      @default(ACTIVE)
  internalStatus      InternalPublicationStatus @default(NOT_PUBLISHED)
  /// true cuando la pausa fue disparada automáticamente por el sistema (worker
  /// detectó SUPPLIER_REMOVED). false cuando el usuario pausó manualmente.
  /// Se usa para decidir si reactivar automáticamente cuando el proveedor
  /// vuelve a traer el producto.
  pausedBySystem      Boolean                   @default(false)

  // Referencia al último snapshot extraído (linea de tiempo)
  latestExtractedProductId String?
  latestExtractedProduct   ExtractedProduct? @relation("LatestSnapshot", fields: [latestExtractedProductId], references: [id])

  // Datos comerciales editados por el usuario (worker NUNCA toca)
  commercialTitle       String?
  commercialName        String?
  commercialDescription String?
  assignedCategoryId    String?
  assignedCategory      Category?    @relation(fields: [assignedCategoryId], references: [id])
  manualPrice           Float?
  manualMargin          Float? // porcentaje manual sobre wholesalePrice
  finalPrice            Float? // precio de venta final (override del cálculo)
  pricingRuleId         String?
  pricingRule           PricingRule? @relation(fields: [pricingRuleId], references: [id])
  notes                 String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  publications ProductPublication[]
  images       CatalogProductImage[]
  /// N:M con Category. La primaria (isPrimary=true) se mantiene en sincro con
  /// `assignedCategoryId` para no romper pricing rules y filtros existentes.
  categories   CatalogProductCategory[]
  eventLogs    EventLog[]

  @@unique([userId, providerId, sku])
  @@index([userId])
  @@index([providerId])
  @@index([supplierStatus])
  @@index([userId, providerId])
  @@index([internalStatus])
  @@index([userId, internalStatus])
  @@index([userId, publicationSku])
  @@index([userId, sourceType])
  @@index([importBatchId])
  @@index([sourceCatalogProductId])
  @@index([userId, stockSource])
}

model ProductPublication {
  id                String            @id @default(cuid())
  catalogProductId  String
  catalogProduct    CatalogProduct    @relation(fields: [catalogProductId], references: [id])
  storeId           String
  store             Store             @relation(fields: [storeId], references: [id])
  status            PublicationStatus @default(DRAFT)
  externalProductId String?
  /// Para tiendas que distinguen producto vs variante (ej: Shopify, Tienda Nube),
  /// guardamos también el id de la variante específica publicada.
  externalVariantId String?
  /// SKU tal como está cargado en la tienda externa. Puede diferir de
  /// CatalogProduct.publicationSku si el cliente lo editó del lado tienda.
  externalSku       String?
  /// SKU comercial canónico (feature lazy SKU — Fase 1). Null hasta que la
  /// publication se publica por primera vez en Woo. En ese momento se
  /// genera como Provider.skuPrefix + CatalogProduct.sku (lógica de Fase 3)
  /// y se persiste inmutable. Reemplaza progresivamente a
  /// CatalogProduct.publicationSku (que se elimina en Fase 5).
  sku               String?
  /// Estado en la tienda externa: "publish" | "draft" | "trash" en WooCommerce,
  /// análogos en Shopify/Tienda Nube. Diferenciado de `status` interno.
  externalStatus    String?
  externalUrl       String?
  publishedAt       DateTime?
  pausedAt          DateTime?
  lastSyncAt        DateTime?
  /// Última sincronización exitosa con la tienda externa (precio/stock/imagen).
  /// Diferenciado de lastSyncAt por compatibilidad con integraciones nuevas.
  lastSyncedAt      DateTime?
  /// Último error de sync; null si la última operación fue exitosa.
  syncError         String?
  errorMessage      String?
  /// Snapshot del precio en la tienda al momento del último sync. Permite
  /// detectar drift entre lo que el motor calcula y lo que está publicado.
  priceInStore      Float?
  /// Baseline de autoridad del precio (D2 — ver docs/d2-price-authority-design.md §2).
  /// ES el precio PERSISTIDO del último push exitoso (el valor enviado a Woo, NUNCA un
  /// recálculo). Su null-ness DERIVA la autoridad del precio de la fila:
  ///   - != null  ⇒ autoridad PricEcom → SYNCED = |computed − lastPushedPrice| ≤ tolerancia.
  ///   - == null  ⇒ autoridad Woo → SYNCED por definición (no reclamamos control).
  /// Lo escribe SOLO el price-push exitoso (publishProductToWoo). Los pulls
  /// (sync/products, link, create-catalog), el pause y el edit de SKU NO lo tocan.
  lastPushedPrice   Float?
  /// Snapshot del stock en la tienda al momento del último sync.
  stockInStore      Int?
  /// Snapshot del nombre de categoría asignado en la tienda externa.
  categoryInStore   String?
  /// Override per-publication del título comercial. Si commercialTitleUserEdited
  /// es true, este valor pisa a CatalogProduct.commercialTitle en el push a la
  /// tienda y NO se sobreescribe en pulls desde Woo. Pensado para multi-store:
  /// el cliente puede tener un título distinto en cada tienda.
  commercialTitle                 String?
  commercialTitleUserEdited       Boolean           @default(false)
  commercialDescription           String?
  commercialDescriptionUserEdited Boolean           @default(false)
  /// Marca que tenemos cambios locales (precio/stock/título/etc.) que aún
  /// no se empujaron a la tienda. El worker de sync lee este flag para
  /// priorizar qué publicar.
  pendingSync       Boolean           @default(false)
  /// Estado del ciclo de sincronización (granularidad mayor que pendingSync).
  syncStatus        PublicationSyncStatus @default(READY)
  finalPrice        Float?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  eventLogs         EventLog[]

  @@unique([catalogProductId, storeId])
  @@index([catalogProductId])
  @@index([storeId])
  @@index([status])
  @@index([storeId, pendingSync])
  @@index([storeId, externalStatus])
  @@index([storeId, syncStatus])
}

/// Galería de imágenes por CatalogProduct. La imagen del proveedor puede
/// importarse acá con source=SUPPLIER, pero también soporta imágenes
/// subidas por el usuario (USER) o generadas (GENERATED) para editing.
model CatalogProductImage {
  id               String         @id @default(cuid())
  catalogProductId String
  catalogProduct   CatalogProduct @relation(fields: [catalogProductId], references: [id], onDelete: Cascade)
  url              String
  position         Int            @default(0)
  isPrimary        Boolean        @default(false)
  source           ImageSource    @default(SUPPLIER)
  altText          String?
  createdAt        DateTime       @default(now())

  @@index([catalogProductId])
  @@index([catalogProductId, position])
}

enum PricingRuleScope {
  GLOBAL
  PROVIDER
  CATEGORY
}

enum RoundingMode {
  NONE
  CEIL
  NEAREST_100
  NEAREST_500
  ENDING_990
}

model PricingRule {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id])
  name          String
  scope         PricingRuleScope
  scopeId       String? // providerId o categoryId según scope (null si GLOBAL)
  marginPercent Float
  method        String           @default("MARKUP_ON_COST")
  roundingMode  RoundingMode     @default(NONE)
  isActive      Boolean          @default(true)
  priority      Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  catalogProducts CatalogProduct[]

  @@index([userId])
  @@index([userId, scope])
  @@index([userId, isActive])
}

model Category {
  id        String                   @id @default(cuid())
  name      String
  slug      String?
  parentId  String?
  parent    Category?                @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[]               @relation("CategoryTree")
  mappings  ProductCategoryMapping[]
  storeCategories StoreCategory[]
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  /// Relación inversa con la M2M (CatalogProductCategory). Convivencia con
  /// `catalogProducts` legacy (vía CatalogProduct.assignedCategoryId, que es
  /// la categoría primaria mantenida en sincro con la fila isPrimary=true de
  /// CatalogProductCategory por compatibilidad con pricing rules y filtros).
  catalogProducts        CatalogProduct[]
  catalogProductCategories CatalogProductCategory[]
}

/// Pivote N:M entre CatalogProduct y Category. La fila con isPrimary=true se
/// mantiene en sincro con CatalogProduct.assignedCategoryId. Cascade: si se
/// elimina el CatalogProduct, se eliminan sus filas; no así si se elimina la
/// Category (la eliminación de categorías la maneja el usuario explícitamente).
model CatalogProductCategory {
  catalogProductId String
  categoryId       String
  catalogProduct   CatalogProduct @relation(fields: [catalogProductId], references: [id], onDelete: Cascade)
  category         Category       @relation(fields: [categoryId], references: [id])
  isPrimary        Boolean        @default(false)
  createdAt        DateTime       @default(now())

  @@id([catalogProductId, categoryId])
  @@index([catalogProductId])
  @@index([categoryId])
  @@index([catalogProductId, isPrimary])
}

model ProductCategoryMapping {
  id               String   @id @default(cuid())
  providerCategory String // categoría tal como viene del proveedor
  categoryId       String
  category         Category @relation(fields: [categoryId], references: [id])
  createdAt        DateTime @default(now())
}

// ────────────────────────────────────────────────────────────────────────────
// EventLog — audit trail unificado
// ────────────────────────────────────────────────────────────────────────────
// Bitácora inmutable de acciones automáticas y manuales (usuario, worker,
// sync, importer, WooCommerce). Permite responder: qué pasó, quién lo hizo,
// qué lo disparó, cuándo, sobre qué entidad. NO usar hard delete.
//
// El logging nunca debe romper el flujo principal — `lib/events/event-log.ts`
// envuelve el create() en try/catch.

enum EventSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum EventSource {
  USER
  WORKER
  SYSTEM
  SYNC
  IMPORT
  EXTRACTION
  WOOCOMMERCE
}

model EventLog {
  id            String        @id @default(cuid())
  createdAt     DateTime      @default(now())

  severity      EventSeverity
  source        EventSource

  /// Identificador semántico del evento (ej: "WOO_PRODUCT_CREATED",
  /// "PRODUCT_AUTO_PAUSED"). Catálogo en docs/event-log.md.
  type          String
  title         String
  description   String?

  userId        String?
  providerId    String?
  productId     String?
  publicationId String?
  storeId       String?
  jobId         String?

  /// JSON libre para contexto adicional (precios old/new, payload Woo, etc).
  metadata      Json?

  // FKs explícitas con NoAction/NoAction: refleja el comportamiento real de
  // las constraints en prod, en vez del default actual de Prisma (SetNull
  // para FK nullable). Drift histórico — prod fue creado con NoAction
  // explícito y schema.prisma asumía el default; el rebaseline alinea
  // ambos lados. Si en el futuro se quiere SetNull (que un User borrado
  // ponga sus EventLogs en null en vez de bloquear), se hace en una
  // migración explícita ALTER TABLE.
  user        User?               @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  provider    Provider?           @relation(fields: [providerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product     CatalogProduct?     @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  publication ProductPublication? @relation(fields: [publicationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  store       Store?              @relation(fields: [storeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  job         ExtractionJob?      @relation(fields: [jobId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([createdAt])
  @@index([severity])
  @@index([source])
  @@index([providerId])
  @@index([productId])
  @@index([publicationId])
  @@index([storeId])
  @@index([jobId])
}
