generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // hash bcrypt
  name      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  providers      Provider[]
  extractionJobs ExtractionJob[]
}

model Provider {
  id                String                 @id @default(cuid())
  name              String
  baseUrl           String
  requiresLogin     Boolean                @default(false)
  username          String?
  encryptedPassword String?
  isActive          Boolean                @default(true)
  notes             String?
  lastExtractionAt  DateTime?
  userId            String?
  user              User?                  @relation(fields: [userId], references: [id])
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  scraperConfig     ProviderScraperConfig?
  extractionJobs    ExtractionJob[]

  @@index([userId])
}

model ProviderScraperConfig {
  id                    String   @id @default(cuid())
  providerId            String   @unique
  provider              Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  productCardSelector   String?
  skuSelector           String?
  nameSelector          String?
  descriptionSelector   String?
  priceSelector         String?
  oldPriceSelector      String?
  stockSelector         String?
  categorySelector      String?
  imageSelector         String?
  productUrlSelector    String?
  nextPageSelector      String?
  maxPages              Int      @default(10)
  waitForSelector       String?
  loginUsernameSelector String?
  loginPasswordSelector String?
  loginSubmitSelector   String?
  /// Prefijo opcional para nombres de archivo en descarga masiva de imágenes (ej: "ART_" → ART_12345.jpg)
  imageFilenamePrefix   String?
  /// Para sitios sin paginación clásica que dividen el catálogo en categorías URL
  /// (ej: Impotekno). Si está configurado, el scraper lee este <select> y itera
  /// por cada option.value usando categoryParamName como query string.
  categoryParamSelector String?
  /// Nombre del parámetro URL para iterar categorías (ej: "rub" → ?rub=N)
  categoryParamName     String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model ExtractionJob {
  id                   String             @id @default(cuid())
  providerId           String
  provider             Provider           @relation(fields: [providerId], references: [id])
  userId               String?
  user                 User?              @relation(fields: [userId], references: [id])
  status               JobStatus          @default(PENDING)
  startUrl             String?
  startedAt            DateTime?
  finishedAt           DateTime?
  /// Porcentaje de progreso 0-100 (actualizado por el worker página a página)
  progress             Int                @default(0)
  totalProducts        Int                @default(0)
  productsWithPrice    Int                @default(0)
  productsWithoutPrice Int                @default(0)
  productsWithoutSku   Int                @default(0)
  /// Ruta local del archivo Excel generado (relativa a /public)
  excelFilePath        String?
  /// URL pública para descarga desde el navegador
  excelFileUrl         String?
  errorMessage         String?
  /// Timestamp del momento en que un worker tomó el job (para detección de locks muertos)
  workerLockedAt       DateTime?
  /// ID del proceso worker que bloqueó el job (útil para debug multi-instancia)
  workerPid            Int?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  products             ExtractedProduct[]
  logs                 ExtractionLog[]

  @@index([status, createdAt])
  @@index([userId])
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model ExtractedProduct {
  id                String               @id @default(cuid())
  jobId             String
  job               ExtractionJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  providerId        String
  sku               String?
  name              String
  description       String?
  wholesalePrice    Decimal?             @db.Decimal(10, 2)
  oldPrice          Decimal?             @db.Decimal(10, 2)
  stock             String?
  category          String?
  brand             String?
  productUrl        String?
  imageUrl          String?
  /// Nombre de archivo de la imagen descargada (sin path, ej: "ART_12345.jpg")
  imageFileName     String?
  /// Ruta local en disco si la imagen fue descargada
  imageFilePath     String?
  /// Cuándo se descargó la imagen
  imageDownloadedAt DateTime?
  status            String?
  observations      String?
  rawData           Json?
  extractedAt       DateTime             @default(now())
  /// null | "selected" | "prepared" | "published" — set por flujo de publicación a tiendas
  publicationStatus String?
  publications      ProductPublication[]

  @@index([jobId])
  @@index([providerId])
  @@index([sku])
}

model ExtractionLog {
  id        String        @id @default(cuid())
  jobId     String
  job       ExtractionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  level     LogLevel      @default(INFO)
  message   String
  metadata  Json?
  createdAt DateTime      @default(now())

  @@index([jobId])
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

// ─── Ecommerce Integration (futuro) ───────────────────────────────────────────

model Store {
  id          String   @id @default(cuid())
  name        String
  platform    String // "tiendanube" | "shopify" | "woocommerce"
  url         String
  isActive    Boolean  @default(true)
  credentials String? // cifrado AES-256 igual que Provider
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  integrations StoreIntegration[]
  publications ProductPublication[]
}

model StoreIntegration {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  config    String? // JSON con config específica de la plataforma
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductPublication {
  id                String           @id @default(cuid())
  productId         String
  product           ExtractedProduct @relation(fields: [productId], references: [id])
  storeId           String
  store             Store            @relation(fields: [storeId], references: [id])
  status            String           @default("selected") // selected | prepared | published | error_publication
  externalProductId String? // ID del producto en la tienda destino
  publishedAt       DateTime?
  errorMessage      String?
  finalPrice        Float? // precio final después de aplicar margen
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model PricingRule {
  id        String   @id @default(cuid())
  scope     String // "global" | "provider" | "category" | "product"
  scopeId   String? // providerId, categoryId o productId según scope
  method    String // "markup" | "margin"
  value     Float // porcentaje
  rounding  Int? // redondear al múltiplo más cercano (ej: 100)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        String                   @id @default(cuid())
  name      String
  slug      String?
  parentId  String?
  parent    Category?                @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[]               @relation("CategoryTree")
  mappings  ProductCategoryMapping[]
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt
}

model ProductCategoryMapping {
  id               String   @id @default(cuid())
  providerCategory String // categoría tal como viene del proveedor
  categoryId       String
  category         Category @relation(fields: [categoryId], references: [id])
  createdAt        DateTime @default(now())
}
