# deps
node_modules/
.pnp
.pnp.js

# Next.js
.next/
out/
build/

# TypeScript build cache
tsconfig.tsbuildinfo

# env
.env
.env.local
.env.*.local
# .env.test contiene URLs de la branch de Neon de test con credenciales reales
# del rol neondb_owner; nunca debe commitearse. .env.test.example sí se versiona
# (sin secretos).
.env.test

# Dumps de prod (rollback points del rebaseline 2026-06-03 y futuros).
# Contienen checksums y timestamps reales — no son sensibles, pero tampoco
# útiles en git. Gitignored para evitar dejarlos accidentalmente.
backups/

# Artefactos locales de scripts (backups de fixes, dumps de diagnóstico,
# JSON crudos de proveedores con precios mayoristas CONFIDENCIALES). El repo
# es público: NADA de artifacts/ debe versionarse.
artifacts/

# Excel exports (generados en runtime)
public/exports/
/exports/

# Datos privados del cliente — Excel fuente que no debe versionarse
scripts/*.xlsx
imports/
*.xlsx
*.xls
*.csv
!exports/.gitkeep

# Claude Code (estado local de la herramienta)
/.claude/

# DB
*.db
*.sqlite

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Playwright
/test-results/
/playwright-report/
/playwright/.cache/

# Scripts efímeros: diagnostico/verificación inline durante sesiones de trabajo.
# Los one-off "definitivos" (que documentan una migración aplicada) van sin
# el prefijo "_temp" y sí se versionan.
scripts/_temp-*.ts
scripts/_snapshot-*.json

