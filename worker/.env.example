# Variables de entorno requeridas por pricecom-worker.
# El worker corre como servicio Railway separado de la app web; comparte la
# misma DB y la misma clave de cifrado de credenciales de proveedores.
#
# Lo que NO necesita (vs app web):
#   NEXTAUTH_SECRET / NEXTAUTH_URL / NEXT_PUBLIC_APP_URL

# Conexión a Postgres (Neon). Mismas que en pricecom-app.
DATABASE_URL=
DIRECT_URL=

# Cifrado AES-256 de credenciales de proveedores (encryptedPassword en DB).
# El worker descifra para autenticarse en sitios con login. Mismo valor que
# en pricecom-app — si difieren, fallan las extracciones que requieren login.
ENCRYPTION_KEY=

# Comportamiento del poll loop.
# WORKER_POLL_INTERVAL: ms entre polls del DbPollingQueue. 5000 = 5s.
# WORKER_STALE_TIMEOUT_MS: cuánto tiempo un job en RUNNING sin progreso se
# considera muerto y se libera automáticamente. 600000 = 10 min.
WORKER_POLL_INTERVAL=5000
WORKER_STALE_TIMEOUT_MS=600000
